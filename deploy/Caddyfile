{$RELAY_DOMAIN} {
    # Device routes require bearer credentials; Apple notifications require signed payloads.
    # Enrollment stays limited to test clients.
    @devices path /v1/access /v1/subscription /v1/apple-notifications /v1/host /v1/sessions/* /v1/devices /v1/devices/*
    handle @devices {
        reverse_proxy relay:8787
    }
    @testClients remote_ip {$TEST_CLIENT_IPS}
    handle @testClients {
        reverse_proxy relay:8787
    }
    handle {
        respond "Private Routi Connect test" 403
    }
}
