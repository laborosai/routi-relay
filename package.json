{
  "name": "routi-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.6.2",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "pair": "tsx src/pair.ts",
    "demo": "tsx src/demo.ts",
    "test:remote": "tsx src/remote-test.ts",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "license": "Apache-2.0",
  "exports": {
    "./connection": {
      "types": "./dist/src/connection.d.ts",
      "default": "./dist/src/connection.js"
    },
    "./pairing": {
      "types": "./dist/src/pairing.d.ts",
      "default": "./dist/src/pairing.js"
    },
    "./relay": {
      "types": "./dist/src/relay.d.ts",
      "default": "./dist/src/relay.js"
    }
  },
  "files": [
    "dist/src",
    "LICENSE",
    "NOTICE"
  ]
}
